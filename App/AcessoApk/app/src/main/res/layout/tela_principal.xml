<?xml version="1.0" encoding="utf-8"?>
<!-- Área logada: conteúdo da aba atual e a barra de navegação inferior.
     As margens das barras do sistema e do teclado são aplicadas em TelaPrincipal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".telas.TelaPrincipal">

    <include
        android:id="@+id/avisoDemonstracao"
        layout="@layout/componente_aviso_demonstracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp" />

    <FrameLayout
        android:id="@+id/containerFragmentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- labelVisibilityMode="labeled": o texto de cada aba aparece sempre,
         não só o ícone -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacaoInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_navegacao_inferior" />
</LinearLayout>
