<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".telas.TelaNovaSenha">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingBottom="@dimen/margem_tela">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/nova_senha_titulo"
                android:textAppearance="@style/Texto.Acesso.TituloTela" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nova_senha_introducao"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/acesso_texto_secundario" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/rotulo_nova_senha"
                app:endIconMode="password_toggle"
                app:helperText="@string/ajuda_senha">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoConfirmacaoSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/rotulo_confirmar_senha"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaConfirmacaoSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/mensagemStatus"
                style="@style/Estilo.Acesso.MensagemStatus" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/acao_salvar_senha" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
