<?xml version="1.0" encoding="utf-8"?>
<!-- Vaga (como o VagaCard do site): logotipo (iniciais) da empresa, título, empresa, local, resumo e selos -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Estilo.Acesso.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaco_cartoes">

    <LinearLayout
        android:id="@+id/conteudoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Logotipo da empresa; sem logo (ou se o download falhar) ficam as iniciais. Decorativo para o
                 TalkBack: o nome da empresa é lido logo ao lado. -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="noHideDescendants">

                <TextView
                    android:id="@+id/textoIniciaisEmpresa"
                    style="@style/Estilo.Acesso.LogoEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/imagemLogoEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:background="@color/acesso_superficie"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/acesso_titulo"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/acesso_texto_secundario"
                    app:drawableTint="@color/acesso_primaria" />

                <TextView
                    android:id="@+id/textoLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/acesso_texto_secundario"
                    app:drawableStartCompat="@drawable/ic_local"
                    app:drawableTint="@color/acesso_texto_secundario" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textoDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/acesso_texto" />

        <!-- Selos: público da vaga, contrato e recursos de acessibilidade -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoSelos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />

        <TextView
            android:id="@+id/textoCandidaturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/acesso_sobre_container_primaria"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
