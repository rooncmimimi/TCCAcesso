<?xml version="1.0" encoding="utf-8"?>
<!-- Balão de mensagem recebida: branco com borda clara, canto inferior esquerdo mais fechado -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/acesso_superficie" />
    <stroke android:width="1dp" android:color="@color/acesso_borda" />
    <corners
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="@dimen/raio_item"
        android:topLeftRadius="@dimen/raio_item"
        android:topRightRadius="@dimen/raio_item" />
</shape>
