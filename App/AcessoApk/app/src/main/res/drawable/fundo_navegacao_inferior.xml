<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo branco da barra de abas com uma linha de 1dp em cima, separando-a do conteúdo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/acesso_borda" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/acesso_superficie" />
        </shape>
    </item>
</layer-list>
