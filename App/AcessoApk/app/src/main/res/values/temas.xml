<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Os nomes dos itens (colorPrimary, textInputStyle...) são atributos do
         Android/Material e não podem ser traduzidos; os valores são nossos. -->
    <style name="Tema.Acesso" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/acesso_primaria</item>
        <item name="colorOnPrimary">@color/acesso_sobre_primaria</item>
        <item name="colorPrimaryContainer">@color/acesso_container_primaria</item>
        <item name="colorOnPrimaryContainer">@color/acesso_sobre_container_primaria</item>
        <item name="colorSecondary">@color/acesso_titulo</item>
        <item name="colorError">@color/acesso_erro</item>
        <item name="colorErrorContainer">@color/acesso_container_erro</item>
        <item name="colorOnErrorContainer">@color/acesso_sobre_container_erro</item>
        <item name="colorOutline">@color/acesso_contorno</item>
        <item name="colorSurface">@color/acesso_fundo</item>
        <item name="colorOnSurface">@color/acesso_texto</item>
        <item name="colorOnSurfaceVariant">@color/acesso_texto_secundario</item>
        <item name="android:colorBackground">@color/acesso_fundo</item>
        <item name="android:windowBackground">@color/acesso_fundo</item>
        <item name="android:statusBarColor">@color/acesso_fundo</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="textInputStyle">@style/Estilo.Acesso.Campo</item>
        <item name="materialButtonStyle">@style/Estilo.Acesso.Botao</item>
        <item name="materialButtonOutlinedStyle">@style/Estilo.Acesso.BotaoContorno</item>
        <item name="borderlessButtonStyle">@style/Estilo.Acesso.BotaoTexto</item>
    </style>

    <!-- Campos com rótulo sempre visível (não só placeholder) -->
    <style name="Estilo.Acesso.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/acesso_superficie</item>
        <item name="errorIconDrawable">@drawable/ic_erro</item>
        <item name="boxCornerRadiusTopStart">@dimen/raio_controle</item>
        <item name="boxCornerRadiusTopEnd">@dimen/raio_controle</item>
        <item name="boxCornerRadiusBottomStart">@dimen/raio_controle</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/raio_controle</item>
    </style>

    <style name="Estilo.Acesso.Botao" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/altura_botao</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="cornerRadius">@dimen/raio_controle</item>
    </style>

    <style name="Estilo.Acesso.BotaoContorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/altura_botao</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="cornerRadius">@dimen/raio_controle</item>
        <item name="strokeColor">@color/acesso_primaria</item>
    </style>

    <style name="Estilo.Acesso.BotaoTexto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="Texto.Acesso.Marca" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/acesso_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Acesso.TituloTela" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/acesso_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Raio decorativo da identidade visual, como na página inicial do site:
         preenche a área cortando as sobras (object-cover), ampliado 1,3x e com
         25% de opacidade. Só decoração: o TalkBack ignora. -->
    <style name="Estilo.Acesso.FundoRaio" parent="">
        <item name="android:src">@drawable/raio_acesso</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:scaleX">1.3</item>
        <item name="android:scaleY">1.3</item>
        <item name="android:alpha">0.25</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Tela de apresentação: página inicial do site. Herda os estilos de botão do app. -->
    <style name="Tema.Acesso.Apresentacao">
        <item name="android:windowBackground">@color/acesso_fundo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Ícones escuros na barra de navegação: só existe a partir do Android 8.1
             (API 27), por isso fica em values-v27/temas.xml. -->
    </style>

    <style name="Estilo.Acesso.Apresentacao.Botao" parent="Estilo.Acesso.Botao">
        <item name="iconGravity">textEnd</item>
        <item name="iconSize">20dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Estilo.Acesso.Apresentacao.BotaoEscuro" parent="Estilo.Acesso.Apresentacao.Botao">
        <item name="backgroundTint">@color/acesso_texto</item>
        <item name="iconTint">@color/acesso_sobre_primaria</item>
    </style>

    <style name="Estilo.Acesso.Apresentacao.BotaoClaro" parent="Estilo.Acesso.BotaoContorno">
        <item name="backgroundTint">@color/acesso_superficie</item>
        <item name="strokeColor">@color/acesso_borda</item>
        <item name="android:textColor">@color/acesso_texto</item>
        <item name="iconTint">@color/acesso_texto</item>
        <item name="iconSize">20dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Botões compactos do cabeçalho (Entrar / Criar conta), ainda com 48dp de toque -->
    <style name="Estilo.Acesso.Apresentacao.BotaoCabecalho" parent="Estilo.Acesso.Apresentacao.Botao">
        <item name="android:minHeight">@dimen/apresentacao_altura_botao_cabecalho</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="Estilo.Acesso.Apresentacao.BotaoCabecalhoClaro" parent="Estilo.Acesso.Apresentacao.BotaoClaro">
        <item name="android:minHeight">@dimen/apresentacao_altura_botao_cabecalho</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <!-- Linha da lista de recursos: fundo cinza-azulado, ícone colorido e texto -->
    <style name="Estilo.Acesso.Apresentacao.Recurso" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/fundo_recurso_apresentacao</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/acesso_texto</item>
    </style>

    <!-- ===== Área logada e componentes compartilhados ===== -->

    <!-- Cartão como o Card do site: branco, borda clara, cantos de 18dp, sem sombra forte -->
    <style name="Estilo.Acesso.Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/acesso_superficie</item>
        <item name="cardCornerRadius">@dimen/raio_cartao</item>
        <item name="strokeColor">@color/acesso_borda</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Lista suspensa (modalidade, contrato, porte...) com os mesmos cantos dos campos -->
    <style name="Estilo.Acesso.Campo.Lista" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/acesso_superficie</item>
        <item name="errorIconDrawable">@drawable/ic_erro</item>
        <item name="boxCornerRadiusTopStart">@dimen/raio_controle</item>
        <item name="boxCornerRadiusTopEnd">@dimen/raio_controle</item>
        <item name="boxCornerRadiusBottomStart">@dimen/raio_controle</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/raio_controle</item>
    </style>

    <style name="Texto.Acesso.TituloSecao" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/acesso_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Selo em pílula: tipo de conta, status, público da vaga, recursos -->
    <style name="Estilo.Acesso.Selo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fundo_selo</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/acesso_texto</item>
    </style>

    <style name="Estilo.Acesso.Selo.Destaque">
        <item name="android:background">@drawable/fundo_selo_destaque</item>
        <item name="android:textColor">@color/acesso_sobre_container_primaria</item>
    </style>

    <!-- Faixa de aviso (modo demonstração, integração pendente): ícone + texto, não só cor -->
    <style name="Estilo.Acesso.Aviso" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fundo_aviso</item>
        <item name="android:padding">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/acesso_sobre_container_aviso</item>
        <item name="drawableTint">@color/acesso_sobre_container_aviso</item>
        <item name="drawableStartCompat">@drawable/ic_informacao</item>
    </style>

    <!-- Iniciais do nome num círculo verde-claro, como o avatar do site sem foto -->
    <style name="Estilo.Acesso.Avatar" parent="">
        <item name="android:layout_width">@dimen/tamanho_avatar</item>
        <item name="android:layout_height">@dimen/tamanho_avatar</item>
        <item name="android:background">@drawable/fundo_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/acesso_sobre_container_primaria</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Linha de menu do Perfil: ícone, texto à esquerda e 56dp de altura de toque -->
    <style name="Estilo.Acesso.ItemMenu" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_botao</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/acesso_texto</item>
        <item name="iconTint">@color/acesso_texto_secundario</item>
        <item name="iconPadding">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.None</item>
    </style>

    <!-- Filtros e opções (modalidade, público, recursos): 48dp de área de toque -->
    <style name="Estilo.Acesso.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Mensagem de status (erro, sucesso ou carregando). O TalkBack lê
         automaticamente quando o texto muda (accessibilityLiveRegion). -->
    <style name="Estilo.Acesso.MensagemStatus" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_campos</item>
        <item name="android:padding">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>
