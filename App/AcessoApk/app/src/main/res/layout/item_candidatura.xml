<?xml version="1.0" encoding="utf-8"?>
<!-- Candidatura: vaga (toque abre o detalhe), empresa, selo com a situação e quando foi enviada -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Estilo.Acesso.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaco_cartoes">

    <LinearLayout
        android:id="@+id/conteudoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/textoIniciaisEmpresa"
            style="@style/Estilo.Acesso.LogoEmpresa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/acesso_titulo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/acesso_texto_secundario" />

            <TextView
                android:id="@+id/textoStatus"
                style="@style/Estilo.Acesso.Selo.Destaque"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textoQuando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/acesso_texto_secundario" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
