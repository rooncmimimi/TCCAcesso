<?xml version="1.0" encoding="utf-8"?>
<!-- Guia dos recursos de acessibilidade do próprio Android. Os cartões de cada recurso são
     componente_secao, preenchidos em TelaAcessibilidade a partir de textos_acessibilidade.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".telas.TelaAcessibilidade">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingBottom="@dimen/margem_tela">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/guia_titulo"
                android:textAppearance="@style/Texto.Acesso.TituloTela" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/guia_introducao"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/acesso_texto_secundario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoAbrirConfiguracoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/guia_abrir_configuracoes" />

            <LinearLayout
                android:id="@+id/listaRecursos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/guia_nota_caminhos"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/acesso_texto_secundario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoAbrirConfiguracoesFim"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/guia_abrir_configuracoes" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
