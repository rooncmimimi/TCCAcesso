<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe da vaga (página /vaga/:id do site): cabeçalho com a ação principal e seções em cartões -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="@string/vaga_titulo_tela" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_tela"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="@dimen/margem_tela">

            <include
                android:id="@+id/estado"
                layout="@layout/componente_estado_conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Estilo.Acesso.Cartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textoIniciaisEmpresa"
                            style="@style/Estilo.Acesso.LogoEmpresa"
                            android:layout_width="56dp"
                            android:layout_height="56dp" />

                        <TextView
                            android:id="@+id/textoTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:accessibilityHeading="true"
                            android:textAppearance="@style/Texto.Acesso.TituloTela" />

                        <TextView
                            android:id="@+id/botaoEmpresa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="4dp"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/acesso_primaria"
                            app:drawableTint="@color/acesso_primaria" />

                        <TextView
                            android:id="@+id/textoLocal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/acesso_texto_secundario"
                            app:drawableStartCompat="@drawable/ic_local"
                            app:drawableTint="@color/acesso_texto_secundario" />

                        <TextView
                            android:id="@+id/textoQuando"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/acesso_texto_secundario" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/grupoSelos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="6dp" />

                        <TextView
                            android:id="@+id/textoVagaFechada"
                            style="@style/Estilo.Acesso.Aviso"
                            android:layout_marginTop="12dp"
                            android:text="@string/vaga_nao_aberta"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botaoCandidatar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/vaga_candidatar"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/mensagemStatus"
                            style="@style/Estilo.Acesso.MensagemStatus" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <include android:id="@+id/secaoDescricao" layout="@layout/componente_secao" />

                <include android:id="@+id/secaoRequisitos" layout="@layout/componente_secao" />

                <include android:id="@+id/secaoBeneficios" layout="@layout/componente_secao" />

                <include android:id="@+id/secaoDetalhes" layout="@layout/componente_secao" />

                <include android:id="@+id/secaoAcessibilidade" layout="@layout/componente_secao" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
