<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Oportunidades.
     Pessoa: busca de vagas com filtros (página /vagas do site). No celular, os selects
     do site viram chips que quebram linha, fáceis de tocar e sem esconder opções.
     Empresa: painel com números e "Minhas vagas" (página /dashboard/empresa do site). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <!-- ===== Pessoa: vagas ===== -->
        <LinearLayout
            android:id="@+id/secaoPessoa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/vagas_titulo"
                android:textAppearance="@style/Texto.Acesso.TituloTela" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/vagas_busca"
                app:endIconContentDescription="@string/acao_buscar"
                app:endIconDrawable="@drawable/ic_pesquisa"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vagas_filtro_modalidade"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/acesso_titulo" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoModalidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipModalidadeTodas"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filtro_todas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresencial"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modalidade_presencial" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHibrido"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modalidade_hibrido" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRemoto"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modalidade_remoto" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vagas_filtro_publico"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/acesso_titulo" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoPublico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPublicoTodos"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filtro_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPcd"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/publico_pcd" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCinquentaMais"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/publico_cinquenta_mais" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPcdCinquentaMais"
                    style="@style/Estilo.Acesso.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/publico_pcd_cinquenta_mais" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/textoContagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/acesso_texto_secundario" />

            <include
                android:id="@+id/estadoVagas"
                layout="@layout/componente_estado_conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/listaVagas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ===== Empresa: painel ===== -->
        <LinearLayout
            android:id="@+id/secaoEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/painel_titulo"
                android:textAppearance="@style/Texto.Acesso.TituloTela" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/painel_subtitulo"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/acesso_texto_secundario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/metricaVagasPublicadas"
                    layout="@layout/componente_metrica"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/metricaVagasAbertas"
                    layout="@layout/componente_metrica"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/metricaCandidaturas"
                    layout="@layout/componente_metrica"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/metricaSeguidores"
                    layout="@layout/componente_metrica"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoPublicarVaga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/acao_publicar_vaga"
                app:icon="@drawable/ic_criar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="@string/painel_minhas_vagas"
                android:textAppearance="@style/Texto.Acesso.TituloSecao" />

            <include
                android:id="@+id/estadoEmpresa"
                layout="@layout/componente_estado_conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/listaVagasEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
