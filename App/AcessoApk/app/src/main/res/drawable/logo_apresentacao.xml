<?xml version="1.0" encoding="utf-8"?>
<!-- Logotipo (como o componente Logo do site): círculo verde com o símbolo de
     acessibilidade. No site o selo tem 36px com cantos de 18px (um círculo) e o
     símbolo 20px, ou seja, ~55% do selo; aqui, 22dp num selo de 40dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/acesso_primaria" />
            <size
                android:width="@dimen/apresentacao_tamanho_logo"
                android:height="@dimen/apresentacao_tamanho_logo" />
        </shape>
    </item>
    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/ic_acessibilidade"
        android:gravity="center" />
</layer-list>
