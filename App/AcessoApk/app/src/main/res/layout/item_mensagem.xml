<?xml version="1.0" encoding="utf-8"?>
<!-- Uma mensagem: balão (à direita e verde se for da conta logada, à esquerda e branco se for recebida)
     e, embaixo, a hora e, nas enviadas, se já foi lida. Lado e cores são definidos em TelaConversa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizMensagem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textoMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/textoHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/acesso_texto_secundario" />
</LinearLayout>
