<?xml version="1.0" encoding="utf-8"?>
<!-- Comentários de uma publicação: o texto dela no topo, a lista (com respostas) e a barra de escrever
     embaixo. As margens do teclado são aplicadas em TelaComentarios (MargensSistema). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="@string/comentarios_titulo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/acesso_borda"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Resumo da publicação comentada -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Estilo.Acesso.Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/resumoPublicacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textoAutorPublicacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/acesso_titulo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textoConteudoPublicacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/acesso_texto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/estado"
                layout="@layout/componente_estado_conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/listaComentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraEnvio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fundo_navegacao_inferior"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/mensagemStatus"
            style="@style/Estilo.Acesso.MensagemStatus"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp" />

        <!-- Aparece ao tocar em Responder -->
        <LinearLayout
            android:id="@+id/faixaResposta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/textoRespondendo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/acesso_texto_secundario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoCancelarResposta"
                style="@style/Estilo.Acesso.BotaoTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancelar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoComentario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/comentarios_campo"
                app:counterMaxLength="1000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaComentario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/botaoEnviar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comentarios_enviar"
                android:enabled="false"
                android:src="@drawable/ic_enviar"
                app:tint="@color/cor_botao_enviar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
