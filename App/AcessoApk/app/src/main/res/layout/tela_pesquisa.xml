<?xml version="1.0" encoding="utf-8"?>
<!-- Pesquisa aberta pelo campo de busca do cabeçalho, em tela própria com Voltar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/containerPesquisa"
        android:name="com.acesso.app.fragmentos.FragmentoPesquisa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
