<?xml version="1.0" encoding="utf-8"?>
<!-- Área logada: conteúdo da aba atual e a barra de navegação inferior.
     As margens das barras do sistema e do teclado são aplicadas em TelaPrincipal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".telas.TelaPrincipal">

    <include
        android:id="@+id/avisoDemonstracao"
        layout="@layout/componente_aviso_demonstracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp" />

    <!-- Cabeçalho compacto: avatar (abre o Perfil) e campo de busca (abre a Pesquisa) -->
    <LinearLayout
        android:id="@+id/cabecalhoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/botaoAvatar"
            style="@style/Estilo.Acesso.Avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:padding="6dp"
            android:clickable="true"
            android:contentDescription="@string/cabecalho_abrir_perfil"
            android:focusable="true"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/botaoBuscaRapida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/fundo_busca_rapida"
            android:clickable="true"
            android:contentDescription="@string/cabecalho_pesquisar_descricao"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/cabecalho_pesquisar"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/acesso_texto_secundario"
            app:drawableStartCompat="@drawable/ic_pesquisa"
            app:drawableTint="@color/acesso_texto_secundario" />

        <!-- Mensagens no canto direito, com o número de não lidas (como em redes profissionais) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp">

            <ImageButton
                android:id="@+id/botaoMensagens"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cabecalho_mensagens"
                android:src="@drawable/ic_mensagem"
                app:tint="@color/acesso_texto_secundario" />

            <TextView
                android:id="@+id/seloMensagens"
                style="@style/Estilo.Acesso.Contador"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/containerFragmentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- labelVisibilityMode="labeled": o texto de cada aba aparece sempre,
         não só o ícone -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacaoInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_navegacao_inferior" />
</LinearLayout>
