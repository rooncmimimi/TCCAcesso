<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho de perfil (o próprio e o de outras contas): capa com o raio da identidade visual,
     avatar com as iniciais sobreposto, nome, título profissional e selos -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Estilo.Acesso.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Capa decorativa (oculta para o TalkBack) com o avatar sobreposto na borda de baixo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:background="@color/acesso_container_primaria"
                android:importantForAccessibility="noHideDescendants">

                <ImageView
                    style="@style/Estilo.Acesso.FundoRaio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/textoIniciais"
                style="@style/Estilo.Acesso.Avatar"
                android:layout_width="@dimen/tamanho_avatar_perfil"
                android:layout_height="@dimen/tamanho_avatar_perfil"
                android:layout_marginStart="20dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/fundo_avatar_perfil"
                android:textSize="26sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/cabecalhoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/textoNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:textAppearance="@style/Texto.Acesso.TituloTela" />

            <TextView
                android:id="@+id/textoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/acesso_texto"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textoEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/acesso_texto_secundario"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textoTipoConta"
                    style="@style/Estilo.Acesso.Selo.Destaque" />

                <TextView
                    android:id="@+id/textoStatusEmpresa"
                    style="@style/Estilo.Acesso.Selo"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
