# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL (Supabase)
DB_HOST=seu-host-do-supabase
DB_PORT=5432
DB_NAME=postgres
DB_USER=seu-usuario-do-supabase
DB_PASSWORD=sua-senha-do-banco
# Use "false" apenas em PostgreSQL local sem SSL
DB_SSL=true

# Autenticação
# Gere um valor forte com: openssl rand -hex 32
JWT_SECRET=coloque-seu-jwt-secret-aqui
JWT_EXPIRES_IN=30m
BCRYPT_ROUNDS=12

# CORS — origens permitidas separadas por vírgula
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Limite específico para vídeos de postagem (confirme o limite real do
# bucket/projeto Supabase antes de subir este valor)
MAX_VIDEO_UPLOAD_BYTES=52428800

# Armazenamento persistente de uploads.
# Sem SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY, os arquivos vão para o disco
# local (UPLOAD_DIR) — adequado para desenvolvimento, mas em produção o
# servidor RECUSA subir sem essas variáveis (ver fail-fast em env.js),
# porque o disco de hosts como o Render é apagado a cada deploy/restart.
#
# Dois buckets — nunca um só — porque têm regras de acesso diferentes:
# - PUBLIC_BUCKET: fotos, capas, logos, anexos de postagem (imagem/vídeo).
#   Bucket público no Supabase Storage.
# - PRIVATE_BUCKET: currículos, certificados e anexos de postagem
#   (Fase 7 — antes, anexo de postagem ia pro bucket público; agora vai
#   sempre pro privado, sem exceção). Bucket PRIVADO — nunca marcar como
#   público — acessado só via URL assinada e temporária.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PUBLIC_BUCKET=public-media
SUPABASE_STORAGE_PRIVATE_BUCKET=private-documents
# Validade da URL assinada de currículo/certificado/mídia de postagem de
# autor PRIVADO, em segundos.
SIGNED_URL_EXPIRES_SECONDS=300
# Fase 7: validade da URL assinada de mídia de postagem de autor
# PÚBLICO/empresa — mais longa de propósito (sem ganho de segurança em
# expirar rápido algo que qualquer um já pode ver; só evita re-assinar
# a mesma mídia toda hora numa sessão normal de navegação no feed).
SIGNED_URL_PUBLIC_EXPIRES_SECONDS=21600

# Sugestão de descrição de imagem por IA (OpenRouter — openrouter.ai).
# Opcional: sem OPENROUTER_API_KEY, o botão "Sugerir descrição" fica
# indisponível e a descrição manual continua funcionando normalmente.
# Nunca coloque a chave real aqui nem no código — só no seu .env local
# (que não é versionado) ou nas variáveis de ambiente do host de deploy.
OPENROUTER_API_KEY=
# Lista de modelos gratuitos com visão, em ordem de prioridade (separados
# por vírgula) — a OpenRouter tenta o próximo se um estiver indisponível.
# Deixe vazio para usar a lista padrão já testada (ver env.js). NÃO usa
# "openrouter/free" (o roteador automático da OpenRouter): ele pode cair
# num modelo sem relação com descrever imagem, como um classificador de
# moderação de conteúdo — já aconteceu em teste real.
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=20000

# E-mail transacional (confirmação de cadastro e recuperação de senha) via
# Brevo (brevo.com — plano gratuito cobre o uso de um TCC). Sem
# BREVO_API_KEY, o cadastro continua funcionando normalmente (sem exigir
# confirmação de e-mail) e a recuperação de senha volta a só logar o
# código no console do servidor — mesmo comportamento de antes desta
# variável existir. Nunca coloque a chave real aqui nem no código — só no
# seu .env local (não versionado) ou nas variáveis de ambiente do host.
BREVO_API_KEY=
# Remetente já verificado no painel do Brevo (Settings > Senders). Não
# funciona com um e-mail qualquer — precisa estar cadastrado e verificado
# lá (endereço próprio ou domínio com SPF/DKIM configurados).
BREVO_REMETENTE_EMAIL=
BREVO_REMETENTE_NOME=ACESSO
BREVO_TIMEOUT_MS=15000