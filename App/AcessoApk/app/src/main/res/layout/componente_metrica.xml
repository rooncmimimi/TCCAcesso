<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de número do painel da empresa (como o MetricaCard do site) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Estilo.Acesso.Cartao"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/conteudoMetrica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/acesso_titulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoRotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/acesso_texto_secundario" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
