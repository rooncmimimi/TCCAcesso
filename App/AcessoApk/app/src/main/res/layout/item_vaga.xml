<?xml version="1.0" encoding="utf-8"?>
<!-- Vaga (como o VagaCard do site): título, empresa, local, resumo e selos -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Estilo.Acesso.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaco_cartoes">

    <LinearLayout
        android:id="@+id/conteudoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/acesso_titulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/acesso_texto_secundario"
            app:drawableTint="@color/acesso_primaria" />

        <TextView
            android:id="@+id/textoLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/acesso_texto_secundario"
            app:drawableStartCompat="@drawable/ic_local"
            app:drawableTint="@color/acesso_texto_secundario" />

        <TextView
            android:id="@+id/textoDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/acesso_texto" />

        <!-- Selos: público da vaga, contrato e recursos de acessibilidade -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoSelos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />

        <TextView
            android:id="@+id/textoCandidaturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/acesso_sobre_container_primaria"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
