<?xml version="1.0" encoding="utf-8"?>
<!-- Lista de conversas (página /mensagens do site), com "Nova mensagem" -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barraSuperior"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="@drawable/ic_voltar"
            app:title="@string/mensagens_titulo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margem_tela"
                android:paddingEnd="@dimen/margem_tela"
                android:paddingBottom="96dp">

                <include
                    android:id="@+id/estado"
                    layout="@layout/componente_estado_conteudo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cartaoLista"
                    style="@style/Estilo.Acesso.Cartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/listaConversas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divisor_lista"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/botaoNovaMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/margem_tela"
        android:text="@string/mensagens_nova"
        android:textColor="@color/acesso_sobre_primaria"
        app:backgroundTint="@color/acesso_primaria"
        app:icon="@drawable/ic_editar"
        app:iconTint="@color/acesso_sobre_primaria" />
</FrameLayout>
