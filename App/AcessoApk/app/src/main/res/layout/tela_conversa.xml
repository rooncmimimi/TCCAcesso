<?xml version="1.0" encoding="utf-8"?>
<!-- Conversa aberta: com quem (toque abre o perfil), mensagens em balões e a barra de escrever embaixo.
     As margens do teclado são aplicadas em TelaConversa (MargensSistema), então a barra fica acima dele. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:subtitleTextColor="@color/acesso_texto_secundario"
        app:title="@string/mensagens_titulo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/acesso_borda"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/rolagemMensagens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <include
                android:id="@+id/estado"
                layout="@layout/componente_estado_conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/listaMensagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/avisoSomenteLeitura"
        style="@style/Estilo.Acesso.Aviso"
        android:layout_margin="16dp"
        android:text="@string/conversa_somente_leitura"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/barraEnvio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fundo_navegacao_inferior"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/mensagemStatus"
            style="@style/Estilo.Acesso.MensagemStatus"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoMensagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/conversa_campo"
                app:counterMaxLength="2000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaMensagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/botaoEnviar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/conversa_enviar"
                android:enabled="false"
                android:src="@drawable/ic_enviar"
                app:tint="@color/cor_botao_enviar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
