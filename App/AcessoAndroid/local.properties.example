# Copie este arquivo para local.properties (o Android Studio já cria um com sdk.dir)
# e acrescente as duas linhas abaixo com os dados do seu projeto Supabase.
# Onde encontrar: Supabase > Project Settings > API.
#
# Use SOMENTE a chave "anon" (pública). Nunca coloque a service_role key aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui
