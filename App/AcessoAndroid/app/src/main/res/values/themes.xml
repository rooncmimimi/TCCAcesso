<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Acesso" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/acesso_primary</item>
        <item name="colorOnPrimary">@color/acesso_on_primary</item>
        <item name="colorPrimaryContainer">@color/acesso_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/acesso_on_primary_container</item>
        <item name="colorSecondary">@color/acesso_title</item>
        <item name="colorError">@color/acesso_error</item>
        <item name="colorErrorContainer">@color/acesso_error_container</item>
        <item name="colorOnErrorContainer">@color/acesso_on_error_container</item>
        <item name="colorOutline">@color/acesso_outline</item>
        <item name="colorSurface">@color/acesso_background</item>
        <item name="colorOnSurface">@color/acesso_text</item>
        <item name="colorOnSurfaceVariant">@color/acesso_text_secondary</item>
        <item name="android:colorBackground">@color/acesso_background</item>
        <item name="android:windowBackground">@color/acesso_background</item>
        <item name="android:statusBarColor">@color/acesso_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="textInputStyle">@style/Widget.Acesso.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Acesso.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Acesso.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Acesso.Button.Text</item>
    </style>

    <!-- Campos com rótulo sempre visível (não só placeholder) -->
    <style name="Widget.Acesso.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/acesso_surface</item>
        <item name="errorIconDrawable">@drawable/ic_error</item>
    </style>

    <style name="Widget.Acesso.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.Acesso.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/acesso_primary</item>
    </style>

    <style name="Widget.Acesso.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="TextAppearance.Acesso.Brand" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/acesso_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Acesso.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/acesso_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Mensagem de status (erro, sucesso ou carregando). O TalkBack lê
         automaticamente quando o texto muda (accessibilityLiveRegion). -->
    <style name="Widget.Acesso.StatusMessage" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/field_spacing</item>
        <item name="android:padding">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>
