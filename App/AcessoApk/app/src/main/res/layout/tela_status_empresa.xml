<?xml version="1.0" encoding="utf-8"?>
<!-- Empresa ainda não aprovada (pendente, reprovada ou suspensa), como a TelaStatusEmpresa
     do site: só a marca, a situação e a saída da conta, sem nenhum caminho para o resto do app. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".telas.TelaStatusEmpresa">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <include
            android:id="@+id/avisoDemonstracao"
            layout="@layout/componente_aviso_demonstracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/apresentacao_tamanho_logo"
                android:layout_height="@dimen/apresentacao_tamanho_logo"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_apresentacao" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/nome_app"
                android:textColor="@color/acesso_texto"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Estilo.Acesso.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/iconeStatus"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/fundo_icone_status"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_ampulheta"
                    app:tint="@color/acesso_sobre_container_aviso" />

                <TextView
                    android:id="@+id/textoTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:textAppearance="@style/Texto.Acesso.TituloTela" />

                <TextView
                    android:id="@+id/textoDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/acesso_texto_secundario" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoSair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/acesso_erro"
                    android:text="@string/acao_sair"
                    app:icon="@drawable/ic_sair" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoFaleConosco"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_fale_conosco" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
