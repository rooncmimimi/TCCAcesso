<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Perfil: cabeçalho e seções profissionais (como o perfil do site) e, abaixo, atalhos da conta e do app -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <include
            android:id="@+id/cabecalho"
            layout="@layout/componente_cabecalho_perfil" />

        <!-- Sobre, competências, experiência e formação, como o perfil do site -->
        <include
            android:id="@+id/secoes"
            layout="@layout/componente_secoes_perfil" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/perfil_secao_conta"
            android:textAppearance="@style/Texto.Acesso.TituloSecao" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Estilo.Acesso.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divisor_lista"
                android:orientation="vertical"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoCandidaturas"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_minhas_candidaturas"
                    app:icon="@drawable/ic_vaga" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoMensagens"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_mensagens"
                    app:icon="@drawable/ic_mensagem" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoEditarPerfil"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_editar"
                    app:icon="@drawable/ic_editar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoCadastrarEmpresa"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_cadastrar_empresa"
                    android:visibility="gone"
                    app:icon="@drawable/ic_empresa" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoSair"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/acao_sair"
                    android:textColor="@color/acesso_erro"
                    app:icon="@drawable/ic_sair"
                    app:iconTint="@color/acesso_erro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/perfil_secao_app"
            android:textAppearance="@style/Texto.Acesso.TituloSecao" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Estilo.Acesso.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divisor_lista"
                android:orientation="vertical"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoAcessibilidade"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_acessibilidade"
                    app:icon="@drawable/ic_acessibilidade" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoTermos"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_termos"
                    app:icon="@drawable/ic_documento" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoFaleConosco"
                    style="@style/Estilo.Acesso.ItemMenu"
                    android:text="@string/perfil_fale_conosco"
                    app:icon="@drawable/ic_email" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/mensagemStatus"
            style="@style/Estilo.Acesso.MensagemStatus" />
    </LinearLayout>
</ScrollView>
