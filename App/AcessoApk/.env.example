# Endereço da API do backend existente (Site/Backend). Nunca commitar o
# arquivo real .env/.env.local — só este .env.example, sem valor sensível.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Fase 25 (observabilidade) — opcional. Sem isto definido, o relato de
# falhas (Sentry) fica desligado e o app funciona normalmente (nenhuma
# tela/serviço depende disto para funcionar). Preencha com o DSN do seu
# projeto Sentry (https://sentry.io/) para ativar.
EXPO_PUBLIC_SENTRY_DSN=
