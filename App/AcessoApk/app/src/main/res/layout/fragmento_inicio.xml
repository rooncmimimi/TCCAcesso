<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Início: feed da comunidade, adaptado da página /feed do site.
     No celular, o resumo do perfil (coluna lateral do site) vira a saudação no topo. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <TextView
            android:id="@+id/textoSaudacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/Texto.Acesso.TituloTela" />

        <TextView
            android:id="@+id/textoSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/acesso_texto_secundario" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Estilo.Acesso.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inicio_compartilhe_titulo"
                    android:textAppearance="@style/Texto.Acesso.TituloSecao" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/inicio_compartilhe_texto"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/acesso_texto_secundario" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoEscrever"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/acao_escrever_publicacao"
                    app:icon="@drawable/ic_criar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="@string/inicio_publicacoes_titulo"
            android:textAppearance="@style/Texto.Acesso.TituloSecao" />

        <include
            android:id="@+id/estado"
            layout="@layout/componente_estado_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/listaPublicacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
