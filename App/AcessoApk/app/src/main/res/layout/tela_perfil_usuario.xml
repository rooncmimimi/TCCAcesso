<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil de outra pessoa ou empresa (página /perfil/:usuarioId do site), com o botão Mensagem -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="@string/perfil_titulo_tela" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_tela"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="@dimen/margem_tela">

            <include
                android:id="@+id/estado"
                layout="@layout/componente_estado_conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/conteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/cabecalho"
                    layout="@layout/componente_cabecalho_perfil" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoMensagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/perfil_acao_mensagem"
                    android:visibility="gone"
                    app:icon="@drawable/ic_mensagem" />

                <TextView
                    android:id="@+id/textoMotivoMensagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/acesso_texto_secundario"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mensagemStatus"
                    style="@style/Estilo.Acesso.MensagemStatus" />

                <include
                    android:id="@+id/secoes"
                    layout="@layout/componente_secoes_perfil" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
